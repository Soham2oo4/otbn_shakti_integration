// allotted space: 24 bytes
// space-allocation: (R: reserved, U-Used)
// 0x0: U R R R
// 0x4: R R R R
// 0x8: U U U U
// 0XC: U U U U
// 0X10:U U U U 
// 0X14:U U U U 

// Memory Map
// Machine-level Software interrrupt device (MSWI)
`define msipreg      'h0000		//HART index 0 machine-level IPI register (MSIP0)
`define msipreg1     'h0004		//HART index 1 machine-level IPI register (MSIP1)

// Time Compare register
`define mtimecmpreg  'h4000		//HART index 0 machine-level time compare (MTIMECMP0)
`define mtimecmpreg1 'h4008		//HART index 1 machine-level time compare (MTIMECMP1)
`define mtimereg     'hbff8	    //Machine-level time counter (MTIME)
