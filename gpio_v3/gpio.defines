// allotted space: 24 bytes
// space-allocation: (R: reserved, U-Used)
// 0x0: U U R R
// 0x4: U R R R
// 0x8: U R R R

// Memory Map
`define dir_reg1 		'h00
`define dir_reg2 		'h04
`define dataout_reg1 	'h08
`define dataout_reg2 	'h0C
`define set_data1		'h10
`define set_data2		'h14
`define clear_data1		'h18
`define clear_data2		'h1C
`define toggle_data1    'h20
`define toggle_data2	'h24
`ifdef IQC
    `define input_qual		'h28
`endif
`define intr_config1	 'h30
`define intr_config2	 'h34
`define GPIO_Clk_en		 'h38
`define intr_status_reg1 'h40
`define intr_status_reg2 'h44
`define intr_enable_reg1 'h48
`define intr_enable_reg2 'h4c
