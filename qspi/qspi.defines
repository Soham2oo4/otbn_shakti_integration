`define verbose


`define CR 		'h00          // control register
`define DCR 	        'h04          // device configuration register
`define SR		'h08          // status register
`define FCR 	        'h0c          // flag clear register
`define DLR		'h10          // data length register
`define CCR 	        'h14          // communication configuration register 
`define AR		'h18          // address register
`define ABR		'h1c          // alternate-byte register 
`define DR		'h20          // data registe
`define PSMKR	        'h24          // polling status mask register    
`define PSMAR	        'h28          // polling status match register
`define PIR		'h2c          // polling interval register
`define LPTR	        'h30          // low-power timeout register
`define Qspi_Clk_En	'h34 

