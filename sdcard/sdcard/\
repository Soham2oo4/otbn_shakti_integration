package tb_sd_controller;

import AXI4_Types   :: *;
import AXI4_Fabric  :: *;
import Semi_FIFOF   :: *;
import Connectable  :: *;
import bsvmksdModel :: *;
import TriState     :: *;

`define PADDR 32
`define Reg_width 64
`define USERSPACE 0

typedef enum{
    IDLE,
    SET_TIMEOUT,
    DISABLE,
    SET_CLKDIV,
    ENABLE,
    LAST_RESPONSE
} Init_core_state deriving(Bits, Eq);

typedef enum {
    SET_COMMAND_REG,
    SET_ARGUMENT_REG,
    READ_NR_INTR_REG,
    READ_ERR_INTR_REG,
    READ_RESP_REG,
    LAST_READ_RESP
} Command_controller deriving(Bits, Eq);

typedef enum {
    IDLE,
    CHECK_BD,
    SET_MEM_ADDR,
    SET_BLOCK_ADDR,
    WAIT_FOR_TX_DONE
} Write_mem_sd_state deriving(Bits, Eq);


interface Ifc_sdcard_in;
    method Action sd_cmd_dat_i(bit cmd_dat);
    method bit sd_cmd_dat_o;
    method Action sd_cmd_oe_i(Bool cmd_oe_i);
    method Action sd_dat_i(Bit#(4) sd_dat);
    method Bit#(4) sd_dat_o;
    method Action sd_dat_oe(Bool dat_oe);
    method Action sd_clk (bit clk); //TODO whether it should be type clock or bit
endinterface


interface Ifc_test_sdc;
    interface AXI4_Master_IFC#(`PADDR, `Reg_width, `USERSPACE) master_test;
    interface AXI4_Slave_IFC#(`PADDR, `Reg_width, `USERSPACE) slave_test;
    interface Ifc_sdcard_in ifc_sdcard_in;
endinterface


module mktb_sd_controller(Ifc_test_sdc);


Reg#(Init_core_state) rg_init_state       <- mkReg(SET_TIMEOUT);
Reg#(Command_controller) rg_command_state <- mkReg(SET_COMMAND_REG);

Ifc_sdModel    sd_model     <- mksdModel;

AXI4_Master_Xactor_IFC#(`PADDR, `Reg_width, `USERSPACE) tb_master_xactor <- mkAXI4_Master_Xactor;

Reg#(Bool)     wr_cmd_en   <- mkReg(False);
Reg#(Bool)    wr_dat_en    <- mkReg(False);
Reg#(Bit#(1))  wr_cmd_dat  <- mkReg(0);
Reg#(Bit#(4))  wr_sd_dat_i <- mkReg(0);



TriState#(Bit#(1))   tri_cmd        <- mkTriState(wr_cmd_en, wr_cmd_dat);
TriState#(Bit#(4))   tri_dat        <- mkTriState(wr_dat_en, wr_sd_dat_i);


mkConnection (tri_cmd.io, sd_model.cmd);
mkConnection (tri_dat.io, sd_model.dat);

// state machine for inititating sdcard controller

rule rl_init_idle_state(rg_init_state == IDLE); // TODO ?
//    rg_init_state <= SET_TIMEOUT;
endrule

rule rl_init_set_timeout(rg_init_state == SET_TIMEOUT);
    let aw = AXI4_Wr_Addr{awaddr: 'hB000002C, awlen: 0, awsize:3,awburst:'b01}; //timeout register
    let w = AXI4_Wr_Data {wdata: 'h9C4, wstrb: 8'b11111111, wlast: True};
    tb_master_xactor.i_wr_addr.enq(aw);
    tb_master_xactor.i_wr_data.enq(w);
    rg_init_state <= DISABLE;
    $display($stime(),": tb_sd_controller: rg_init_state SET_TIMEOUT");
endrule

rule rl_init_disable_core(rg_init_state == DISABLE);
    let resp <- pop_o(tb_master_xactor.o_wr_resp);
    let aw = AXI4_Wr_Addr{awaddr: 'hB0000028, awlen: 0, awsize:3,awburst:'b01}; // software reset
    let w = AXI4_Wr_Data {wdata: 'h1, wstrb: 8'b11111111, wlast: True};
    tb_master_xactor.i_wr_addr.enq(aw);
    tb_master_xactor.i_wr_data.enq(w);
    rg_init_state <= SET_CLKDIV;
    $display($stime(),": tb_sd_controller: rg_init_state DISABLE");
endrule

rule rl_init_set_clock_divider(rg_init_state == SET_CLKDIV);
    let resp <- pop_o(tb_master_xactor.o_wr_resp);
    let aw = AXI4_Wr_Addr{awaddr: 'hB000004C, awlen: 0, awsize:3,awburst:'b01}; // clock_divider
    let w = AXI4_Wr_Data {wdata: 'h2, wstrb: 8'b11111111, wlast: True};
    tb_master_xactor.i_wr_addr.enq(aw);
    tb_master_xactor.i_wr_data.enq(w);
    rg_init_state <= ENABLE;
    $display($stime(),": tb_sd_controller: rg_init_state SET_CLKDIV");
endrule

rule rl_init_enable_core(rg_init_state == ENABLE);
    let resp <- pop_o(tb_master_xactor.o_wr_resp);
    let aw = AXI4_Wr_Addr{awaddr: 'hB0000028, awlen: 0, awsize:3,awburst:'b01}; // software reset
    let w = AXI4_Wr_Data {wdata: 'h0, wstrb: 8'b11111111, wlast: True};
    tb_master_xactor.i_wr_addr.enq(aw);
    tb_master_xactor.i_wr_data.enq(w);
    rg_init_state <= LAST_RESPONSE;
    $display($stime(),": tb_sd_controller: rg_init_state ENABLE");
endrule

rule rl_init_last_response(rg_init_state == LAST_RESPONSE);
    let resp <- pop_o(tb_master_xactor.o_wr_resp);
    rg_init_state <= IDLE;
    $display($stime(),": tb_sd_controller: rg_init_state LAST_RESPONSE");
endrule

// state machine for sending command to the sdcard

rule rl_write_response_pop;
    let response <- pop_o(tb_master.o_wr_resp);
    $display($stime(),": tb_sd_controller: Slave write response");
endrule

rule rl_read_response_pop;
    let response <- pop_o(tb_master.o_rd_data);
    $display($stime(),": tb_sd_controller: Slave read response %x", response.rdata);
endrule

rule rl_command_set_cmd_reg(rg_command_state == SET_COMMAND_REG && rg_init_state == IDLE);
    let aw = AXI4_Wr_Addr{awaddr: 'hB0000004, awlen: 0, awsize:3,awburst:'b01}; //cmd setting reg
    let w = AXI4_Wr_Data {wdata: 'h81A, wstrb: 8'b11111111, wlast: True};
    tb_master_xactor.i_wr_addr.enq(aw);
    tb_master_xactor.i_wr_data.enq(w);
    rg_command_state <= SET_ARGUMENT_REG;
    $display($stime(),": tb_sd_controller: rg_command_state SET_COMMAND_REG");
endrule

rule rl_command_set_argument_reg(rg_command_state == SET_ARGUMENT_REG);
    let resp <- pop_o(tb_master_xactor.o_wr_resp);
    let aw = AXI4_Wr_Addr{awaddr: 'hB0000000, awlen: 0, awsize:3,awburst:'b01}; //argument register
    let w = AXI4_Wr_Data {wdata: 'h1AA, wstrb: 8'b11111111, wlast: True};
    tb_master_xactor.i_wr_addr.enq(aw);
    tb_master_xactor.i_wr_data.enq(w);
    rg_command_state <= READ_NR_INTR_REG;
    $display($stime(),": tb_sd_controller: rg_command_state SET_ARGUMENT_REG");
endrule

rule rl_command_read_normal_interrupt_register(rg_command_state == READ_NR_INTR_REG);
    let resp <- pop_o(tb_master_xactor.o_wr_resp);
    let read_request = AXI4_Rd_Addr{araddr: 'hB0000030, arlen:0, arsize:3, arburst:'b01};
    tb_master_xactor.i_rd_addr.enq(read_request);
    rg_command_state <= READ_ERR_INTR_REG;
    $display($stime(),": tb_sd_controller: rg_command_state READ_NR_INTR_REG");
endrule

rule rl_command_read_error_interrupt_register(rg_command_state == READ_ERR_INTR_REG);
    let response <- pop_o(tb_master_xactor.o_rd_data);
    let read_request = AXI4_Rd_Addr{araddr: 'hB0000034, arlen:0, arsize:3, arburst:'b01};
    tb_master_xactor.i_rd_addr.enq(read_request);
    rg_command_state <= READ_RESP_REG;
    $display($stime(),": tb_sd_controller: rg_command_state READ_ERR_INTR_REG %x", response.rdata);
endrule

rule rl_command_read_response_register(rg_command_state == READ_RESP_REG);
    let response <- pop_o(tb_master_xactor.o_rd_data);
    let read_request = AXI4_Rd_Addr{araddr: 'hB000000C, arlen:0, arsize:3, arburst:'b01};
    tb_master_xactor.i_rd_addr.enq(read_request);
    rg_command_state <= LAST_READ_RESP;
    $display($stime(),": tb_sd_controller: rg_command_state READ_RESP_REG %x", response.rdata);
endrule

rule rl_command_last_read_response(rg_command_state == LAST_READ_RESP);
    let response <- pop_o(tb_master_xactor.o_rd_data);
    $display($stime(),": tb_sd_controller: rg_command_state LAST_READ_RESP %x", response.rdata);
endrule

interface Ifc_sdcard_in ifc_sdcard_in;
    method Action sd_cmd_dat_i(bit cmd_dat);
        wr_cmd_dat <= cmd_dat;
    endmethod
    method bit sd_cmd_dat_o;
        return tri_cmd._read;
    endmethod
    method Action sd_cmd_oe_i(Bool cmd_oe_i);
        wr_cmd_en <= cmd_oe_i;
    endmethod
    method Action sd_dat_i(Bit#(4) sd_dat);
        wr_sd_dat_i <= sd_dat;
    endmethod
    method Bit#(4) sd_dat_o;
        return tri_dat._read;
    endmethod
    method Action sd_dat_oe(Bool dat_oe);
        wr_dat_en <= dat_oe;
    endmethod
    method Action sd_clk (bit clk); //TODO whether it should be type clock or bit
        sd_model.isd_clk(clk);
    endmethod
endinterface

    interface master_test = tb_master_xactor.axi_side;

endmodule
endpackage















