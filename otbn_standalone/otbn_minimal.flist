# Minimal OTBN packages (dependency-ordered) + key SV sources for Verilator
# Packages must be compiled explicitly; modules resolve via -y directories

# ---- Core prim packages ----
prim/rtl/prim_util_pkg.sv
prim/rtl/prim_mubi_pkg.sv
prim/rtl/prim_secded_pkg.sv
prim/rtl/prim_cipher_pkg.sv
prim/rtl/prim_alert_pkg.sv
prim/rtl/prim_ram_1p_pkg.sv
prim/rtl/prim_subreg_pkg.sv
prim/rtl/prim_count_pkg.sv
prim/rtl/prim_esc_pkg.sv

# ---- prim_generic packages (ram_2p, rom needed by some prim modules) ----
prim_generic/rtl/prim_ram_2p_pkg.sv
prim_generic/rtl/prim_rom_pkg.sv

# ---- IP packages ----
top_earlgrey/rtl/top_pkg.sv
rtl/edn_pkg.sv
lc_ctrl/rtl/lc_ctrl_state_pkg.sv
lc_ctrl/rtl/lc_ctrl_reg_pkg.sv
lc_ctrl/rtl/lc_ctrl_pkg.sv
tlul/rtl/tlul_pkg.sv
otp_ctrl/rtl/otp_ctrl_pkg.sv
keymgr/rtl/keymgr_reg_pkg.sv
keymgr/rtl/keymgr_pkg.sv
otbn/rtl/otbn_pkg.sv
otbn/rtl/otbn_reg_pkg.sv

# ---- Top-level wrapper + bridge (explicitly compile to be safe) ----
rtl/otbn_axi_wrapper.sv
tlul/rtl/axi64_to_tl64_bridge.sv
