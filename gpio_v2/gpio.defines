// allotted space: 24 bytes
// space-allocation: (R: reserved, U-Used)
// 0x0: U U R R
// 0x4: U R R R
// 0x8: U R R R

// Memory Map
`define dir_reg 		'h0
`define dataout_reg 	'h8
`define set_data		'h10
`define clear_data		'h18
`define toggle_data		'h20
`ifdef IQC
    `define input_qual		'h28
`endif
`define intr_config		'h30
`define GPIO_Clk_en		'h38
